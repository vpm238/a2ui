        color: var(--a2-text-secondary);
      }

      .b-links {
        list-style: none;
        margin: 4px 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 20px;
      }

      .b-links a {
        font-size: 14px;
        font-weight: 600;
        color: var(--a2-accent);
        text-decoration: none;
      }

      .b-links a:hover {
