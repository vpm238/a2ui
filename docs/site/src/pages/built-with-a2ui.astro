import '../styles/tokens.css';

import GenUiSpectrum from '../components/GenUiSpectrum.astro';
import ProductionShowcase from '../components/ProductionShowcase.astro';
import StarlightHeader from '../components/StarlightHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface StoryLink {
  label: string;
  href: string;
}

interface Story {
  /** Anchor that the logos in ProductionShowcase link to. */
  id: string;
  team: string;
  product: string;
  title: string;
  body: string[];
  image?: {src: string; alt: string; caption: string; tall?: boolean};
  /** Shown in place of an image when a team has no approved screenshot. */
  docs?: (StoryLink & {kind: string})[];
  links: StoryLink[];
}

const stories: Story[] = [
  {
    id: 'alation',
    team: 'Alation',
    product: 'Alation AIOS',
    title:
      'Alation shows its AI-generated data feeds with A2UI, in its own app and inside AI assistants such as Claude.',
    body: [
      'The Alation Intelligence Operating System (AIOS) builds its feeds using A2UI: metric cards, charts, and more. Each chart can show the SQL query and data behind it.',
      'Ask Claude for a feed about profitable products, and the feed renders in the conversation using A2UI to render metric cards, charts, and custom components. The same feed with the same information can be viewed directly inside Alation with a nearly identical layout.',
    ],
    image: {
      src: `${base}/assets/built-with/alation-feed-claude-and-alation.webp`,
      alt: 'An Office Supplies Profitability Tracker feed with metric cards and bar charts, shown in a Claude conversation and in the Alation Data Products App.',
      caption:
        "The same Alation feed rendered in Claude (left) and in Alation's Data Products App (right).",
    },
    links: [{label: 'Alation', href: 'https://www.alation.com'}],
  },
  {
    id: 'bytedance',
    team: 'ByteDance',
    product: 'Lynx',
    title:
      'ByteDance built an A2UI renderer into Lynx, its open-source framework for mobile, web and desktop apps.',
    body: [
      'ByteDance released an A2UI renderer for Lynx, its cross-platform framework, in June. Lynx keeps streamed screens smooth and ships a default set of components built on its lynx-ui library.',
      'In the Lynx GenUI Playground you can watch A2UI messages render natively, for example as a two-day trip planner for Kyoto. Lynx supports A2UI 0.9 today and is working with the A2UI team on 1.0 and A2UI Express.',
    ],
    image: {
      src: `${base}/assets/built-with/lynx-genui-playground-kyoto.webp`,
      alt: 'The Lynx GenUI Playground with A2UI createSurface and updateComponents messages on the left and a Kyoto trip planner rendered in a phone frame on the right.',
      caption:
        'In the Lynx GenUI Playground, A2UI messages (left) render natively in Lynx as a Kyoto trip planner (right).',
    },
    links: [
      {label: 'Lynx GenUI Playground', href: 'https://lynx-stack.dev/genui/#/a2ui'},
      {label: 'Lynx A2UI docs', href: 'https://lynxjs.org/next/react/genui/a2ui.html'},
      {
        label: 'Source',
        href: 'https://github.com/lynx-family/lynx-stack/tree/main/packages/genui/a2ui',
      },
    ],
  },
  {
    id: 'atlassian',
    team: 'Atlassian',
    product: 'Jira',
    title:
      'Atlassian is bringing A2UI to Jira, where teams can assign work items to AI agents.',
    body: [
      'When an agent needs a follow-up from the team to finish a work item, such as a missing detail or a decision, it asks with an interactive card in the work item, and the team answers right there in Jira.',
    ],
    image: {
      src: `${base}/assets/built-with/jira-agent-follow-up.webp`,
      alt: 'An agent in Jira asks how many test cases to write for a sticky note colour feature, with four options, a field for another answer, and Skip and Send answers buttons.',
      caption: 'An agent asks the team for a follow-up inside a Jira work item.',
      tall: true,
    },
    links: [
      {
        label: 'AI agents in Jira',
        href: 'https://support.atlassian.com/jira-software-cloud/docs/work-with-ai-agents-in-jira/',
      },
    ],
  },
  {
    id: 'gemini-enterprise',
    team: 'Google Cloud',
    product: 'Gemini Enterprise',
    title: 'Gemini Enterprise runs custom A2UI agents that companies build and register themselves.',
    body: [
      "A team builds an agent that replies with A2UI, hosts it (for example, on Cloud Run), and registers it in Gemini Enterprise. The agent's replies then render as interactive UI in Gemini Enterprise, using the components in its A2UI component gallery.",
    ],
    docs: [
      {
        kind: 'Google Cloud blog',
        label: 'Guide to Gemini Enterprise and A2UI integration',
        href: 'https://cloud.google.com/blog/topics/developers-practitioners/guide-to-gemini-enterprise-and-a2ui-integration',
      },
      {
        kind: 'Documentation',
        label: 'Register and manage an A2UI agent',
        href: 'https://docs.cloud.google.com/gemini/enterprise/docs/a2ui-agents/register-and-manage-an-a2ui-agent',
      },
      {
        kind: 'Reference',
        label: 'A2UI component gallery',
        href: 'https://docs.cloud.google.com/gemini/enterprise/docs/a2ui-agents/a2ui-component-gallery-reference',
      },
      {
        kind: 'Tutorial',
        label: 'Host an A2UI agent on Cloud Run',
        href: 'https://docs.cloud.google.com/gemini/enterprise/docs/a2ui-agents/tutorial-host-agent-cloud-run',
      },
    ],
    links: [],
  },
  {
    id: 'gemini-notebook',
    team: 'Gemini',
    product: 'Gemini Notebook',
    title: 'Gemini Notebook asks what you want with A2UI cards before it generates.',
    body: [
      'Ask Gemini Notebook for a slide deck and it replies with a card that asks two things: presenter slides or a detailed deck, and which topics to focus on. A review card follows with the format, focus and visual style, which you can edit before it generates.',
      'The same cards guide Video Overviews on the web and on mobile.',
    ],
    image: {
      src: `${base}/assets/built-with/gemini-notebook-planning-cards.webp`,
      alt: 'Two Gemini Notebook cards for a Neapolitan pizza slide deck: an options card to pick the deck type and focus topics, and a review card to edit format, focus and visual style.',
      caption: 'The options card (left) and the review card (right) in Gemini Notebook.',
    },
    links: [],
  },
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Built with A2UI | A2UI</title>
    <meta
      name="description"
      content="How A2UI helps across the generative UI spectrum, and what teams at Alation, ByteDance, Atlassian, and Google ship with it."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          document.documentElement.setAttribute(
            'data-theme',
            saved === 'dark' || saved === 'light' ? saved : 'light'
          );
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main data-pagefind-body>
      <section class="a2-hero b-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap b-hero__inner">
          <h1 class="a2-h1 b-h1">Built with <span class="a2-h-accent">A2UI.</span></h1>
          <p class="a2-lead">
            A2UI helps whether the model picks a pre-built widget, composes a new screen, or writes
            its own code. Teams inside Google and across the industry already ship it in their
            products.
          </p>
          <div class="a2-hero__actions">
            <a
              href="https://go.copilotkit.ai/a2ui-playground"
              target="_blank"
              rel="noopener noreferrer"
              class="a2-btn a2-btn--primary"
            >
              <span>Try the A2UI Playground</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href={`${base}/quickstart/`} class="a2-btn a2-btn--outline">
              <span>Run the quickstart</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="b-hero__note">
            The A2UI Playground is built by our partner CopilotKit. To edit surface JSON by hand, open <a
              href="https://a2ui-editor.ag-ui.com"
              target="_blank"
              rel="noopener noreferrer">A2UI Composer</a
            >.
          </p>
        </div>
      </section>

      <GenUiSpectrum />

      <section class="a2-section b-mcp" id="mcp-apps" aria-labelledby="b-mcp-title">
        <div class="a2-wrap">
          <div class="b-mcp__head">
            <h2 class="a2-h2" id="b-mcp-title">
              A2UI and MCP Apps <span class="a2-h-accent">work in both directions.</span>
            </h2>
            <p class="b-mcp__lead">
              An MCP App is a container: an MCP server ships an HTML resource and the host shows it in a
              sandboxed iframe. A2UI can hold that container, or run inside it.
            </p>
          </div>
          <ul class="b-mcp__grid">
            <li class="b-mcp__card">
              <span class="b-mcp__dir">MCP Apps in A2UI</span>
              <h3>Put an MCP App on your A2UI surface.</h3>
              <p>
                The <code>McpApp</code> component runs a third-party HTML widget, such as a Kanban
                board, in a sandbox on your surface. The UI around it stays in your own components,
                and the widget's state and tool calls stay in sync with your agent.
              </p>
              <a href={`${base}/guides/mcp-apps-in-a2ui/`}>Embed MCP Apps in A2UI surfaces →</a>
            </li>
            <li class="b-mcp__card">
              <span class="b-mcp__dir">A2UI in MCP Apps</span>
              <h3>Show A2UI in any host that supports MCP Apps.</h3>
              <p>
                Bundle an A2UI renderer inside an MCP App, and hosts such as Claude display your A2UI
                surfaces without adding A2UI code of their own. Alation already uses this to show its
                A2UI feeds in Claude.
              </p>
              <a href={`${base}/guides/a2ui-in-mcp-apps/`}>Render A2UI inside an MCP App →</a>
            </li>
          </ul>
          <p class="b-mcp__more">
            Compare all four ways to combine A2UI and MCP in the <a
              href={`${base}/guides/mcp-overview/`}>MCP integration overview</a
            >.
          </p>
        </div>
      </section>

      <ProductionShowcase showStoriesLink={false} />

      <section class="a2-section b-stories" id="stories" aria-labelledby="b-stories-title">
        <div class="a2-wrap">
          <h2 class="a2-h2 b-stories__title" id="b-stories-title">What each team built</h2>

          <div class="b-list">
            {
              stories.map((story) => (
                <article
                  class:list={['b-story', {'b-story--tall': story.image?.tall}]}
                  id={story.id}
                  aria-labelledby={`${story.id}-title`}
                >
                  <div class="b-story__media">
                    {story.image ? (
                      <figure class="b-figure">
                        <img
                          src={story.image.src}
                          alt={story.image.alt}
                          loading="lazy"
                          decoding="async"
                        />
                        <figcaption>{story.image.caption}</figcaption>
                      </figure>
                    ) : (
                      <ul class="b-docs" aria-label={`${story.product} resources`}>
                        {story.docs?.map((doc) => (
                          <li>
                            <a href={doc.href} target="_blank" rel="noopener noreferrer">
                              <span class="b-docs__kind">{doc.kind}</span>
                              <span class="b-docs__label">
                                {doc.label} <span aria-hidden="true">↗</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>

                  <div class="b-story__copy">
                    <p class="b-story__eyebrow">
                      <span>{story.team}</span>
                      <span aria-hidden="true">·</span>
                      <span>{story.product}</span>
                    </p>
                    <h3 class="b-story__title" id={`${story.id}-title`}>
                      {story.title}
                    </h3>
                    {story.body.map((paragraph) => (
                      <p class="b-story__body">{paragraph}</p>
                    ))}
                    {story.links.length > 0 && (
                      <ul class="b-links">
                        {story.links.map((link) => (
                          <li>
                            <a href={link.href} target="_blank" rel="noopener noreferrer">
                              {link.label} <span aria-hidden="true">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="a2-footer">
      <div class="a2-wrap a2-footer__inner">
        <div class="a2-footer__brand">
          <strong>A2UI</strong>
          <span>/</span>
          <span>Apache 2.0 Open Source Project</span>
        </div>
        <nav class="a2-footer__links" aria-label="Footer links">
          <a href={`${base}/quickstart/`}>Quickstart</a>
          <a href={`${base}/concepts/overview/`}>Concepts</a>
          <a href={`${base}/concepts/sdks/`}>SDKs</a>
          <a href={`${base}/ecosystem/renderers/`}>Ecosystem</a>
          <a href={`${base}/specification/v1.0-a2ui/`}>Specification</a>
          <a href={`${base}/get-help/`}>Get Help</a>
          <a href="https://github.com/a2ui-project/a2ui" target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </nav>
      </div>
    </footer>

    <style>
      :global(*, *::before, *::after) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--a2-bg);
        color: var(--a2-text);
        font-family: var(--a2-font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .a2-page {
        margin: 0;
        background: var(--a2-bg);
        color: var(--a2-text);
        overflow-x: clip;
      }

      .a2-wrap {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 36px;
      }

      @media (max-width: 640px) {
        .a2-wrap {
          padding: 0 20px;
        }
      }

      .a2-topbar {
        position: sticky;
        top: 0;
        z-index: 60;
        height: 64px;
        background: var(--a2-bg-nav);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--a2-border);
      }

      .a2-topbar__inner {
        max-width: 1280px;
        height: 100%;
        margin: 0 auto;
        padding: 0 24px;
      }

      .a2-hero {
        position: relative;
        padding: 72px 0 80px;
        overflow: clip;
      }

      .a2-hero__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(to right, var(--a2-border-subtle) 1px, transparent 1px),
          linear-gradient(to bottom, var(--a2-border-subtle) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        pointer-events: none;
      }

      .b-hero__inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
      }

      .a2-h1 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-weight: 700;
        letter-spacing: var(--a2-tracking-display);
        color: var(--a2-text);
      }

      .b-h1 {
        font-size: clamp(2.5rem, 4.6vw, 3.8rem);
        line-height: 1.04;
      }

      .a2-h-accent {
        color: var(--a2-heading-accent);
      }

      .a2-lead {
        margin: 0;
        max-width: 58ch;
        font-size: 17px;
        line-height: 1.65;
        letter-spacing: var(--a2-tracking-body);
        color: var(--a2-text-secondary);
      }

      .a2-hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
      }

      .a2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 20px;
        border-radius: 3px;
        font-family: var(--a2-font-sans);
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition:
          background-color 0.15s ease,
          border-color 0.15s ease,
          color 0.15s ease,
          transform 0.15s ease;
      }

      .a2-btn--primary {
        background: var(--a2-cta-bg);
        color: var(--a2-cta-fg);
        border: 1px solid var(--a2-cta-bg);
      }

      .a2-btn--primary:hover {
        background: var(--a2-cta-hover);
        border-color: var(--a2-cta-hover);
        transform: translateY(-1px);
      }

      .a2-btn--outline {
        background: transparent;
        color: var(--a2-text);
        border: 1px solid var(--a2-border-strong);
      }

      .a2-btn--outline:hover {
        border-color: var(--a2-text);
      }

      .b-hero__note {
        margin: 0;
        max-width: 64ch;
        font-size: 13.5px;
        line-height: 1.6;
        color: var(--a2-text-muted);
      }

      .b-hero__note a {
        color: var(--a2-accent);
        text-underline-offset: 3px;
      }

      .a2-section {
        position: relative;
        padding: 112px 0 128px;
        border-top: 1px solid var(--a2-border-strong);
        scroll-margin-top: 72px;
      }

      @media (max-width: 720px) {
        .a2-section {
          padding: 80px 0 88px;
        }
      }

      .a2-h2 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(1.85rem, 3vw, 2.45rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: var(--a2-tracking-h2);
        color: var(--a2-text);
      }

      .b-mcp {
        background: var(--a2-bg-alt);
      }

      .b-mcp__head {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 40px;
      }

      .b-mcp__lead {
        margin: 0;
        max-width: 62ch;
        font-size: 16.5px;
        line-height: 1.65;
        color: var(--a2-text-secondary);
      }

      .b-mcp__grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      @media (max-width: 820px) {
        .b-mcp__grid {
          grid-template-columns: 1fr;
        }
      }

      .b-mcp__card {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 26px;
        border: 1px solid var(--a2-border-strong);
        border-radius: 8px;
        background: var(--a2-surface);
      }

      .b-mcp__dir {
        font-family: var(--a2-font-mono);
        font-size: 11px;
        letter-spacing: var(--a2-tracking-mono-wide);
        text-transform: uppercase;
        color: var(--a2-accent);
      }

      .b-mcp__card h3 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: 1.2rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: var(--a2-tracking-h3);
        color: var(--a2-text);
      }

      .b-mcp__card p {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        color: var(--a2-text-secondary);
      }

      .b-mcp__card code {
        font-family: var(--a2-font-mono);
        font-size: 0.88em;
      }

      .b-mcp__card a,
      .b-mcp__more a {
        font-weight: 600;
        color: var(--a2-accent);
        text-decoration: none;
      }

      .b-mcp__card a {
        margin-top: auto;
        padding-top: 4px;
        font-size: 14px;
      }

      .b-mcp__card a:hover,
      .b-mcp__more a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .b-mcp__more {
        margin: 24px 0 0;
        font-size: 14px;
        color: var(--a2-text-secondary);
      }

      .b-stories__title {
        margin-bottom: 56px;
      }

      .b-list {
        display: flex;
        flex-direction: column;
        gap: 88px;
      }

      .b-story {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 56px;
        align-items: center;
        scroll-margin-top: 88px;
      }

      .b-story:nth-child(even) .b-story__media {
        order: 2;
      }

      .b-story--tall {
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      }

      @media (max-width: 900px) {
        .b-story,
        .b-story--tall {
          grid-template-columns: 1fr;
          gap: 28px;
        }

        .b-story:nth-child(even) .b-story__media {
          order: 0;
        }

        .b-list {
          gap: 64px;
        }
      }

      .b-story__media {
        min-width: 0;
      }

      .b-figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .b-figure img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--a2-border-strong);
        border-radius: 8px;
        background: var(--a2-surface);
      }

      .b-story--tall .b-figure img {
        max-width: 460px;
        margin: 0 auto;
      }

      .b-figure figcaption {
        font-size: 13px;
        line-height: 1.5;
        color: var(--a2-text-muted);
      }

      .b-docs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      @media (max-width: 520px) {
        .b-docs {
          grid-template-columns: 1fr;
        }
      }

