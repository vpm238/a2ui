// A second quickstart button for readers who already have an app: copy a
// prompt that adds A2UI to it using the A2UI agent skill (skills/a2ui/SKILL.md).
import antigravity from '../../../assets/quickstart/travel-a2ui/agents/antigravity.svg';
import claude from '../../../assets/quickstart/travel-a2ui/agents/claude.svg';
import codex from '../../../assets/quickstart/travel-a2ui/agents/codex.svg';
import cursor from '../../../assets/quickstart/travel-a2ui/agents/cursor.svg';
import {absolute, local} from '../../../lib/travel-a2ui/site';

const SKILL_PATH = 'skills/a2ui.md';
const logos = [antigravity, claude, codex, cursor];
const prompt =
  'Add A2UI to this app. If you support agent skills, install the A2UI skill with ' +
  '"npx skills add a2ui-project/a2ui"; otherwise read ' +
  `${absolute(SKILL_PATH)}. Then use it to choose the A2UI packages for this ` +
  'project and set them up.';
---

<section class="sp not-content" aria-label="Add A2UI to your own app">
  <p class="sp__title">
    <strong>Have your own app?</strong> Copy a prompt that adds A2UI to it with the A2UI agent skill.
  </p>
  <div class="sp__row">
    <button type="button" class="sp__copy" data-sp-copy data-prompt={prompt}>
      <span class="sp__logos" aria-hidden="true">
        {logos.map(logo => <img src={logo.src} alt="" width="18" height="18" />)}
      </span>
      <span data-sp-label aria-live="polite">Copy prompt</span>
    </button>
    <a class="sp__view" href={local(SKILL_PATH)}>View skill →</a>
  </div>
</section>

<script>
  import {copyText} from '../../../lib/copy-text';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sp-copy]')) {
    const label = button.querySelector<HTMLElement>('[data-sp-label]')!;
    // One reset at a time, as in the quickstart button.
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const done = await copyText(button.dataset.prompt ?? '');
      label.textContent = done ? 'Copied' : 'Copy failed';
      clearTimeout(reset);
      reset = setTimeout(() => (label.textContent = 'Copy prompt'), 1400);
    });
  }
</script>

<style>
  .sp {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .sp__title {
    margin: 0 0 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .sp__title strong {
    color: var(--sl-color-white);
  }
  .sp__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .sp__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem 0.45rem 0.55rem;
    border: 1.5px solid var(--sl-color-accent);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-text-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .sp__copy:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }
  .sp__copy:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
  .sp__logos {
    display: inline-flex;
  }
  .sp__logos img {
    width: 1.45rem;
    height: 1.45rem;
    padding: 0.2rem;
    border: 1.5px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: #fff;
  }
  .sp__logos img + img {
    margin-left: -0.4rem;
  }
  .sp__view {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
</style>
